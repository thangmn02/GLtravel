<script src='https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js'></script>

<!-- FORCE OVERRIDE STYLES - Load after external CSS -->
<style is:global>
  /* SPECIFIC POPUP TARGETING - Only target images inside popups */
