  }
  
  .back-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    background: #667eea;
    color: white;
  }
  
  .back-button svg {
    width: 20px;
    height: 20px;
  }
  
  /* Logo overlay */
  .map-logo {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 120px;
