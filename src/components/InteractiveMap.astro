    z-index: 10;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
    transition: opacity 0.3s ease;
  }
  
  .map-logo:hover {
    opacity: 0.9;
  }
  
  /* Places Search Box */
  .search-input {
    position: absolute;
    top: 20px;
    right: 60px;
    width: 320px;
    padding: 12px 16px;
    font-size: 15px;
    font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    background: white;
